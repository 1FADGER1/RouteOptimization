@{
    ViewData["Title"] = "Исходники";
}

<!-- Шапка -->
<div class="row text-center mt-5">
    <div class="col">
        <h1 class="display-3 fw-bold" style="color: #24292e;">Исходники</h1>
        <p class="lead text-muted">Здесь вы можете найти ссылки на исходные коды проекта.</p>
    </div>
</div>

<!-- GitHub блок -->
<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg hover-effect">
            <div class="card-body text-center p-5">
                <i class="fab fa-github fa-3x mb-4" style="color: #24292e;"></i>
                <h4 class="card-title fw-bold">GitHub Репозиторий</h4>
                <p class="card-text text-muted">
                    Основной репозиторий проекта находится на GitHub. Вы можете просмотреть код, создать Issue или предложить изменения через Pull Request.
                </p>
                <a href="https://github.com/username/repo" class="btn btn-outline-dark btn-lg mt-3" target="_blank">
                    Перейти на GitHub
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Инструкция по клонированию -->
<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card border-0 shadow-lg hover-effect">
            <div class="card-body text-center p-5">
                <i class="fas fa-terminal fa-3x mb-4" style="color: #007bff;"></i>
                <h4 class="card-title fw-bold">Клонирование репозитория</h4>
                <p class="card-text text-muted">
                    Вы можете клонировать репозиторий с GitHub, выполнив следующую команду:
                </p>
                <pre><code class="bg-light p-3 rounded">git clone https://github.com/username/repo.git</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- Будущие планы -->
<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card border-0 shadow-lg hover-effect">
            <div class="card-body text-center p-5">
                <i class="fas fa-bullseye fa-3x mb-4" style="color: #ffc107;"></i>
                <h4 class="card-title fw-bold">Будущие планы</h4>
                <p class="card-text text-muted">
                    В будущем мы планируем добавить ссылки на другие платформы и обновление проекта.
                </p>
            </div>
        </div>
    </div>
</div>